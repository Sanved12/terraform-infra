# Local .terraform directories
**/.terraform/*

# .tfstate files (stored remotely in S3)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude tfvars — contains secrets (oauth token, public key)
# Commit terraform.tfvars.example instead
*.tfvars
*.tfvars.json

# Windows Zone.Identifier metadata files
*:Zone.Identifier

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI config file
.terraformrc
terraform.rc

# Plan files (uploaded as artifacts in CI)
tfplan
*.tfplan
plan_output.txt

# Mac
.DS_Store

# IDE
.idea/
.vscode/
*.swp
